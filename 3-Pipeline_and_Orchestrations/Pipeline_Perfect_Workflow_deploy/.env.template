# ============================================
# NYC Taxi ML Pipeline - Environment Variables
# ============================================

# Copy this file to .env and fill in your values
# cp .env.template .env

# ============================================
# Prefect Configuration
# ============================================

# Prefect API URL (local server)
PREFECT_API_URL=http://127.0.0.1:4200/api

# For Prefect Cloud (optional)
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
# PREFECT_API_KEY=your-prefect-cloud-api-key

# ============================================
# MLflow Configuration
# ============================================

# MLflow tracking URI
MLFLOW_TRACKING_URI=sqlite:///mlflow_nyc_taxi.db

# MLflow experiment name
MLFLOW_EXPERIMENT_NAME=nyc_taxi_production_mlflow_fast

# MLflow registered model name
MLFLOW_MODEL_NAME=nyc_taxi_predictor

# ============================================
# Kaggle Credentials
# ============================================

# Get these from: https://www.kaggle.com/settings
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================
# Pipeline Configuration
# ============================================

# Data configuration
SAMPLE_SIZE=200000
CHUNK_SIZE=500000
NUM_CHUNKS=2

# Model configuration
RANDOM_STATE=42
TEST_SIZE=0.2
VAL_SIZE=0.2
CV_FOLDS=5

# Training options
SKIP_TUNING=false
SKIP_CV=false

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_FILE=pipeline.log

# ============================================
# Retry Configuration
# ============================================

MAX_RETRIES=3
RETRY_DELAY=5

# ============================================
# Directory Configuration
# ============================================

MODEL_DIR=models_nyc_taxi_mlflow_fast
DATA_DIR=data_nyc_taxi_mlflow_fast
LOG_DIR=logs

# ============================================
# Notification Configuration (Optional)
# ============================================

# Slack webhook for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email notifications (if using SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=alerts@yourcompany.com
